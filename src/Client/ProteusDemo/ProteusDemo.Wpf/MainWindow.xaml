<Window
    x:Class="TheXDS.Proteus.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:gn="http://schemas.thexds.local/ganymede"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vm="clr-namespace:TheXDS.Proteus.ViewModels;assembly=ProteusDemo"
    mc:Ignorable="d"
    ui:Design.Background="{ui:ThemeResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{ui:ThemeResource TextFillColorPrimaryBrush}"
    Height="450" Width="800">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Images.xaml"/>                
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Window.Background>
        <ImageBrush Stretch="UniformToFill" ImageSource="{StaticResource AppBg}"/>
    </Window.Background>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <!--<ui:TitleBar
            HorizontalContentAlignment="Stretch"
            Height="30"
            CloseWindowByDoubleClickOnIcon="True"
            Title="{Binding Navigator.CurrentViewModel.Title, Mode=OneWay, ElementName=vmHost, StringFormat='{}{0} - Proteus demo' }">
            <ui:TitleBar.TrailingContent>-->
                <DockPanel HorizontalAlignment="Stretch" Margin="0 0 5 0" Background="Black">
                    <ui:Button
                        IsTabStop="False"
                        Focusable="False"
                        Command="{Binding Navigator.NavigateBackCommand, Mode=OneWay, ElementName=vmHost}"
                        WindowChrome.IsHitTestVisibleInChrome="True"
                        Background="Transparent"
                        BorderBrush="{x:Null}"
                        BorderThickness="0"
                        Padding="10,7">&lt;</ui:Button>
                </DockPanel>
            <!--</ui:TitleBar.TrailingContent>
        </ui:TitleBar>-->
        <gn:NavigationHost
            Grid.Row="1"
            x:Name="vmHost"
            DialogService="{gn:NavDialogService}"
            Navigator="{gn:NavService Home={x:Type vm:WelcomeViewModel}}">
            <gn:NavigationHost.VisualResolver>
                <gn:WpfResolverStack>
                    <gn:ProteusStackVisualResolver/>
                    <gn:WpfConventionVisualResolver/>
                </gn:WpfResolverStack>
            </gn:NavigationHost.VisualResolver>
        </gn:NavigationHost>
    </Grid>
</Window>